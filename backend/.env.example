PORT=5000
# Thay thế bằng thông tin Supabase Project của bạn từ Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Node backend only: private service_role key (required for writes and admin RPCs).
# Never include this key in Flutter/mobile builds or client-side configuration.
SUPABASE_KEY=your-private-service-role-key
# Optional override only when admin RPCs use a separate service-role key.
# SUPABASE_ADMIN_KEY=
FINWISE_ADMIN_EMAILS=admin@example.com
# Leave unset in production until a real root account is provisioned.
# FINWISE_ROOT_ADMIN_EMAILS=

# Khóa bí mật ký JWT Token
# Generate a unique random secret (at least 32 bytes) and keep it server-side.
JWT_SECRET=

# Địa chỉ AI Microservice Python (FastAPI)
AI_SERVICE_URL=http://localhost:8000
